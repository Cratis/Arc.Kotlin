<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Arc.Kotlin.HttpConformance</AssemblyName>
        <RootNamespace>HttpConformance</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
        <RollForward>Disable</RollForward>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode>true</RestoreLockedMode>
        <NuGetAudit>false</NuGetAudit>
        <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
        <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Update="Microsoft.AspNetCore.App" RuntimeFrameworkVersion="10.0.11" />
        <PackageReference Include="Cratis.Arc" Version="[22.14.0]" />
    </ItemGroup>
</Project>
