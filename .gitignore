# Gradle and build output
.gradle/
.kotlin/
**/build/
ContractTests/TypeScript/generated/
ContractTests/TypeScript/node_modules/
Samples/*/*/src/main/resources/static/
# The sample frontend's proxies are generated from whichever backend is about to run, so the
# checked-in tree never holds a copy that can disagree with the server.
Samples/Frontend/src/generated/
Samples/Frontend/node_modules/
Samples/Frontend/dist/

# JVM artifacts and diagnostics
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.log
hs_err_pid*
replay_pid*

# IDEs and editors
.idea/
*.iml
.vscode/
.project
.classpath
.settings/

# Operating system files
.DS_Store
Thumbs.db

# Local AI work and task artifacts
.ai-work/
.pi/
.playwright-cli/
.playwright-mcp/
